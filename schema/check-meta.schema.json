{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/L4pisLazuli/make-it-lint/schema/check-meta.schema.json",
  "title": "make-it-lint check metadata",
  "description": "make-it-lint/v1. YAML block in the leading comment of a check file. Ledger-born checks set incident. Reusable checks without a local incident set origin plus enforcement.state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "incident": {
      "type": "string",
      "pattern": "^F-[0-9]{8}-[0-9]{2,}$"
    },
    "origin": { "type": "string", "minLength": 1 },
    "input": { "type": "string", "enum": ["tree", "diff", "action"] },
    "layer": {
      "enum": ["architecture", "type", "lint", "test", "verify", "hook", "ci"]
    },
    "tool": {
      "type": "string",
      "enum": ["script", "semgrep", "ast-grep", "test", "hook", "property", "runtime", "model"]
    },
    "seed": { "type": "integer" },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "proven",
            "shadow",
            "comment",
            "block",
            "retired"
          ]
        }
      }
    }
  },
  "anyOf": [
    { "required": ["incident"] },
    { "required": ["origin"] }
  ]
}
